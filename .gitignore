# Node
node_modules/
dist/
.turbo/

# Rust
target/
# NOTE: Cargo.lock is committed (workspace ships binaries).

# Env
.env
.env.*
!.env.example

# Release signing keys (MUST NEVER be committed — see scripts/sign-release.mjs)
*.key
talos-updater*
talos-test-*
# Staged CLI sidecars for Tauri bundles (release automation only; see
# scripts/stage-cli-binaries.mjs). The .gitkeep stays so dev builds work.
apps/desktop/src-tauri/binaries/talos-*

# OS
.DS_Store
Thumbs.db

# Build artifacts
build/
out/
coverage/
# Dev-server copy of the latest audit report (regenerated by the swarm; docs/reports is canonical)
apps/ui/public/reports/
*.log
logs/
*.tsbuildinfo
# Tauri codegen (regenerated by tauri-build)
apps/desktop/src-tauri/gen/
# Tauri ACL scratch output (Prompt 017 C3): `permissions/autogenerated/` is
# tool-generated (`DO NOT EDIT` headers), unreferenced by
# capabilities/default.json (`permissions: []`), and stale since before
# Prompt 011. Regenerable; never committed.
apps/desktop/src-tauri/permissions/autogenerated/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
