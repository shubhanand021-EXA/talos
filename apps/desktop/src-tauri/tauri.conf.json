{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talos",
  "version": "0.4.0",
  "identifier": "com.talos.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter ui dev",
    "beforeBuildCommand": "pnpm --filter ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talos",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost;",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173;",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Talos",
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Policy-gated AI agent command center",
    "longDescription": "Talos is a local-first AI agent command center: coding, browser-use, computer-use, orchestration, evidence, and audit under one policy broker.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../../../LICENSE", "../../../README.md"],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3"]
      },
      "appimage": {
        "files": {}
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.talos.dev/stable/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "RWQBc5+Q8tGcQaoYI+qXO+ZxfCxmAeGUfvo1mthx+kUhV5EbRmMAEjKV"
    }
  }
}
