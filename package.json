{
  "name": "talos",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "setup": "pnpm install",
    "lint": "prettier --check . && pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "node --test tools/ && pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "audit": "pnpm audit --audit-level high",
    "audit:swarm": "pnpm --filter @talos/audit-swarm run audit",
    "demo:batch2": "node tools/demo/batch2.mjs",
    "demo:awakening": "node tools/demo/awakening.mjs",
    "demo:awakening:llm": "node tools/demo/awakening.mjs --llm-real",
    "media:generate": "node scripts/media/generate-brand.mjs",
    "dev:ui": "pnpm --filter ui dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "build:desktop": "pnpm --filter desktop exec tauri build"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
