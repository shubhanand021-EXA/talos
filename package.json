{
  "name": "talos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "setup": "pnpm install",
    "lint": "prettier --check . && pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "node --test tools/ && pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
